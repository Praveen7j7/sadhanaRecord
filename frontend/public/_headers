/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://sadhana-record-api.iyfdelhi-sadhana.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# hashed build files never change: cache them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The paintings, the emblem and the icons (22 Oct 2026, G4): they were served max-age=0, so every view asked the server
# again. They are named by painting / size, not by content hash, so they are NOT immutable — a re-encoded painting
# keeps its name and must reach phones within the month. The catalogue (darshan.json, blur.json) stays always-fresh:
# the image rules match by extension so they never overlap it (two matching rules would merge their Cache-Control).
/darshan/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/darshan/*.avif
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/darshan/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/darshan/*.json
  Cache-Control: no-cache
# Vaishnava Songs (phase 21): the song data and the two books. Named by language, not by content hash, so a
# re-import must still reach phones: a day's cache, then revalidated in the background.
/songs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# motion.css and contrast.css: in the service worker's precache, which fetches them by revision on every release, so
# a header would change nothing for an installed app; left to revalidate for a plain browser tab.

# the page, the service worker and its parts, the manifest: always ask whether there is a newer version
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/push-sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# which build is live (store apps, release checks) and the files the release script carries over: always fresh
/version.json
  Cache-Control: no-cache
/release-assets.json
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
# the public account-deletion page (Google Play) and its styles: always fresh
/delete-account.html
  Cache-Control: no-cache
/delete-account
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/legal.css
  Cache-Control: no-cache
